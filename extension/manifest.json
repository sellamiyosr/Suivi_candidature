{
  "manifest_version": 3,
  "name": "PFE Application Tracker",
  "version": "1.0.0",
  "description": "Ajoute une offre d'emploi à PFE Tracker en un clic.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "PFE Tracker"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
